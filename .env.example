# ==============================================================================
# Content Box — пример переменных окружения.
# Скопируйте в `.env` (`cp .env.example .env`) и подставьте свои значения.
# НИКОГДА не коммитьте реальный `.env` — он в .gitignore.
# ==============================================================================

# --- База данных (PostgreSQL, обязательно) --------------------------------
# Именно DATABASE_URL (с L), не DATABASE_URI.
DATABASE_URL=postgres://user:password@host:5432/contentbox

# --- Payload (обязательно) ------------------------------------------------
# Длинная случайная строка. Сгенерировать: `openssl rand -base64 32`.
# При смене секрета разлогинятся сессии и сломаются зашифрованные поля/токены.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- Медиа: объектное хранилище S3 (Timeweb Cloud, обязательно) ------------
# Timeweb Cloud S3: endpoint https://s3.twcstorage.ru, регион ru-1,
# path-style адреса. Ключи S3 создаются в панели Timeweb → S3-хранилище.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=your-timeweb-bucket
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# Публичный адрес раздачи файлов (path-style: endpoint + бакет). Нужен ДВАЖДЫ:
# как Build Argument для `next build` (иначе next/image не пропустит хост)
# И как рантайм-переменная. Бакет должен быть публичным на чтение.
S3_PUBLIC_URL=https://s3.twcstorage.ru/your-timeweb-bucket
#
# Legacy Cloudflare R2 — код падает на эти переменные фолбэком, если S3_* пусты.
# Можно удалить после перехода на Timeweb.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=your-bucket-name
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Видео: Kinescope (обязательно для работы с видео) ---------------------
KINESCOPE_API_TOKEN=your-kinescope-api-token
KINESCOPE_PARENT_ID=your-kinescope-parent-folder-id

# --- Почта: RuSender API (транзакционные письма) ---------------------------
# Авторизация сервиса токеном + ID ключа. Ключ создаётся в RuSender
# («Транзакционные отправки» → создать ключ, привязать к подтверждённому домену),
# активируется поддержкой. Без RUSENDER_API_TOKEN почта отключена (письма не шлём).
RUSENDER_API_TOKEN=rs_ck_v1_xxxxxxxxxxxxxxxx
RUSENDER_API_KEY_ID=12345
# База API (обычно можно не задавать — дефолт ниже; уточните в кабинете RuSender):
# RUSENDER_API_BASE=https://api.beta.rusender.ru
# Отправитель по умолчанию (адрес должен принадлежать домену ключа):
EMAIL_FROM_ADDRESS=noreply@contentbox.site
EMAIL_FROM_NAME=Content Box
# Reply-To (опц.) — реальный ящик для ответов (напр. на mail.ru/Yandex),
# т.к. noreply@ обычно без входящих. Пусто — Reply-To не добавляется.
# EMAIL_REPLY_TO=support@contentbox.site

# --- Дайджест-уведомления --------------------------------------------------
# Секрет для планировщика рассылки. Внешний cron дёргает
# POST /api/notifications/digest с заголовком `Authorization: Bearer <секрет>`
# (или `x-cron-secret: <секрет>`). Пусто — эндпоинт отвечает 503 и не рассылает.
CRON_SECRET=change-me-to-a-long-random-string

# --- Поиск (Meilisearch) ---------------------------------------------------
# Обе переменные читает src/search/meili.ts. Если хотя бы одна пуста, поиск
# МОЛЧА отключается: страница /search и подсказки отдают пустой результат, а
# индексация в хуках пропускается. Ошибки при этом нигде не всплывают — так
# задумано, чтобы локальная разработка работала без docker-compose.meili.
#
# Локально: `docker compose -f docker-compose.meili.yml up -d`, хост
# http://127.0.0.1:7700. В проде Meilisearch поднимается сервисом из
# docker-compose.yml и виден приложению как http://meilisearch:7700.
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-to-a-long-random-string

# --- Поиск: ключ только для чтения (опционально, задел) --------------------
# Для варианта, когда браузер ходит в Meilisearch напрямую с ограниченным
# токеном (src/search/tenant-token.ts). Сейчас не используется — весь поиск
# идёт через серверные роуты, которые применяют тенант-фильтр сами.
# MEILI_SEARCH_KEY_UID=
# MEILI_SEARCH_KEY=

# --- Cloudflare Stream (опционально, legacy) -------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CF_STREAM_CUSTOMER_CODE=
# CF_STREAM_KEY_ID=
# CF_STREAM_SIGNING_KEY=
