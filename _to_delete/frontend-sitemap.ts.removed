import type { MetadataRoute } from 'next'
import { headers as getHeaders } from 'next/headers.js'
import { getPayload } from 'payload'
import config from '@/payload.config'
import { getTenantFromHeaders } from '@/lib/tenant'

/**
 * Карта сайта тенанта: публикации + публичные профили участников (SEO-приоритет).
 * Профили с profilePrivate/isBlocked и без handle не включаем. Абсолютные URL
 * строим из request-хоста (мультитенант — у каждого сайта свой sitemap).
 */
export const dynamic = 'force-dynamic'

export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const ctx = await getTenantFromHeaders()
  const tenant = (ctx as any)?.tenant
  if (!tenant?.id) return []

  const h = await getHeaders()
  const host = h.get('x-forwarded-host') || h.get('host') || ''
  const proto = h.get('x-forwarded-proto') || 'https'
  if (!host) return []
  const origin = `${proto}://${host}`

  const payload = await getPayload({ config: await config })

  const [pubs, profiles] = await Promise.all([
    payload.find({
      collection: 'publications',
      where: { tenant: { equals: tenant.id } },
      sort: '-publishedAt',
      limit: 5000,
      depth: 0,
      overrideAccess: true,
    }),
    payload.find({
      collection: 'subscribers',
      where: {
        and: [
          { tenant: { equals: tenant.id } },
          { handle: { exists: true } },
          { profilePrivate: { not_equals: true } },
          { isBlocked: { not_equals: true } },
        ],
      },
      limit: 5000,
      depth: 0,
      overrideAccess: true,
    }),
  ])

  const entries: MetadataRoute.Sitemap = [{ url: origin, changeFrequency: 'daily', priority: 1 }]

  for (const p of pubs.docs as any[]) {
    if (!p.slug) continue
    entries.push({
      url: `${origin}/publication/${p.slug}`,
      lastModified: p.updatedAt || p.publishedAt || undefined,
      changeFrequency: 'weekly',
      priority: 0.8,
    })
  }
  for (const s of profiles.docs as any[]) {
    if (!s.handle) continue
    entries.push({
      url: `${origin}/u/${s.handle}`,
      lastModified: s.updatedAt || undefined,
      changeFrequency: 'weekly',
      priority: 0.5,
    })
  }

  return entries
}
